{
  "name": "comparex-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "database",
    "testing"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run generate -w backend && npm run build -w frontend",
    "start": "npm start -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "start:backend": "npm start -w backend",
    "test": "npm run test --workspaces",
    "prepare": "node -e \"try { if (process.env.NODE_ENV !== 'production') require('child_process').execSync('husky', {stdio: 'inherit'}) } catch (e) {}\""
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5"
  }
}
